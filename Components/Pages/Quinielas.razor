@page "/quinielas"
@rendermode InteractiveServer
@inject SessionService Session
@inject QuinielaV2Service QuinielaService
@inject NavigationManager Nav

<PageTitle>Quinielas - Quinielas V2</PageTitle>

@if (ListaQuinielas is null)
{
    <p>Cargando quinielas...</p>
}
else
{
    <h1>Mis quinielas</h1>
    <p>Se muestran las quinielas públicas y las privadas a las que pertenece el usuario.</p>

    @if (ListaQuinielas.Count == 0)
    {
        <div class="alert alert-info">No hay quinielas disponibles para este usuario.</div>
    }

    @foreach (var quiniela in ListaQuinielas)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>@quiniela.Nombre</strong>
                <span class="badge @(quiniela.EsPrivada ? "text-bg-dark" : "text-bg-success")">
                    @(quiniela.EsPrivada ? "Privada" : "Pública")
                </span>
            </div>
            <div class="card-body">
                <p>@quiniela.Descripcion</p>

                @if (quiniela.PerteneceUsuario)
                {
                    <div class="alert alert-secondary py-2">Usted pertenece a esta quiniela.</div>
                }

                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Pos.</th>
                                <th>Usuario</th>
                                <th>Nombre</th>
                                <th>Puntos</th>
                                <th>Insignias</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var participante in quiniela.Participantes)
                            {
                                <tr>
                                    <td>@participante.Posicion</td>
                                    <td>@participante.NombreUsuario</td>
                                    <td>@participante.Nombre</td>
                                    <td><strong>@participante.Puntos</strong></td>
                                    <td>
                                        @if (participante.Insignias.Count == 0)
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                        else
                                        {
                                            @foreach (var insignia in participante.Insignias)
                                            {
                                                <span class="badge text-bg-warning me-1">🏅 @insignia</span>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<QuinielaResumen>? ListaQuinielas;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.EstaAutenticado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (Session.EsAdministrador)
        {
            Nav.NavigateTo("/admin");
            return;
        }

        if (Session.UsuarioActual is not null)
        {
            ListaQuinielas = await QuinielaService.ObtenerParaUsuarioAsync(Session.UsuarioActual.Id);
        }
    }
}
