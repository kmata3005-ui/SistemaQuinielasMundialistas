@page "/admin/reportes"
@rendermode InteractiveServer
@inject SessionService Session
@inject EstadisticaV2Service EstadisticaService
@inject ReporteExportService Exportador
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Reportes administrativos - Quinielas V2</PageTitle>

@if (Datos is null)
{
    <p>Cargando reportes...</p>
}
else
{
    <h1>Reportes del administrador</h1>
    <p>Estadísticas visibles exclusivamente para el rol Administrador.</p>

    <div class="d-flex gap-2 flex-wrap mb-4">
        <button class="btn btn-success" @onclick="DescargarCsv">Descargar CSV</button>
        <button class="btn btn-outline-success" @onclick="DescargarTxt">Descargar TXT</button>
        <button class="btn btn-danger" @onclick="DescargarPdf">Descargar PDF</button>
    </div>

    <div class="alert alert-secondary">
        El PDF se genera con código propio del proyecto, sin librerías externas de generación PDF.
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card h-100"><div class="card-body">
                <h5>Resultado más repetido</h5>
                <div class="fs-4">@Datos.ResultadoMasRepetido</div>
            </div></div>
        </div>

        <div class="col-md-6">
            <div class="card h-100"><div class="card-body">
                <h5>Partido con más aciertos</h5>
                <div class="fs-4">@Datos.PartidoConMasAciertos</div>
            </div></div>
        </div>

        <div class="col-md-6">
            <div class="card h-100"><div class="card-body">
                <h5>Partido con más pronósticos</h5>
                <div class="fs-4">@Datos.PartidoConMasPronosticos</div>
            </div></div>
        </div>

        <div class="col-md-3">
            <div class="card h-100"><div class="card-body">
                <h5>Promedio de goles</h5>
                <div class="display-6">@Datos.PromedioGoles.ToString("0.00")</div>
            </div></div>
        </div>

        <div class="col-md-9">
            <div class="card h-100"><div class="card-body">
                <h5>Partido sin aciertos</h5>
                <div class="fs-4">@Datos.PartidoSinAciertos</div>
            </div></div>
        </div>
    </div>

    <h3 class="mt-5">Usuarios con más aciertos</h3>
    <p>La misma lista permite consultar Top 1, Top 3 y Top 5.</p>

    <div class="btn-group mb-3">
        <button class="btn @(CantidadTop == 1 ? "btn-primary" : "btn-outline-primary")" @onclick="() => CantidadTop = 1">Top 1</button>
        <button class="btn @(CantidadTop == 3 ? "btn-primary" : "btn-outline-primary")" @onclick="() => CantidadTop = 3">Top 3</button>
        <button class="btn @(CantidadTop == 5 ? "btn-primary" : "btn-outline-primary")" @onclick="() => CantidadTop = 5">Top 5</button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr><th>Pos.</th><th>Usuario</th><th>Aciertos</th><th>Puntos obtenidos</th></tr>
            </thead>
            <tbody>
                @foreach (var usuario in Datos.TopUsuarios.Take(CantidadTop))
                {
                    <tr>
                        <td>@usuario.Posicion</td>
                        <td>@usuario.NombreUsuario</td>
                        <td>@usuario.Aciertos</td>
                        <td>@usuario.Puntos</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private EstadisticasAdministrador? Datos;
    private int CantidadTop = 5;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.EstaAutenticado || !Session.EsAdministrador)
        {
            Nav.NavigateTo("/login");
            return;
        }

        Datos = await EstadisticaService.ObtenerAdministradorAsync();
    }

    private async Task DescargarCsv()
    {
        if (Datos is null) return;
        await Descargar("reporte_administrador.csv", "text/csv;charset=utf-8", Exportador.CrearCsvAdministrador(Datos));
    }

    private async Task DescargarTxt()
    {
        if (Datos is null) return;
        await Descargar("reporte_administrador.txt", "text/plain;charset=utf-8", Exportador.CrearTxtAdministrador(Datos));
    }

    private async Task DescargarPdf()
    {
        if (Datos is null) return;
        await Descargar("reporte_administrador.pdf", "application/pdf", Exportador.CrearPdfAdministrador(Datos));
    }

    private async Task Descargar(string nombre, string tipo, byte[] contenido)
    {
        string base64 = Convert.ToBase64String(contenido);
        await JS.InvokeVoidAsync("quinielasDownload.fromBase64", nombre, tipo, base64);
    }
}
